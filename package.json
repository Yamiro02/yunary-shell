{
  "name": "@yunary/shell",
  "version": "0.1.9",
  "description": "Coque partagée des apps Yunary — client Supabase unique, session, crédits, layout, pages Paramètres / auth / légales, bilan d'audit, cartes du profil créateur.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "setup": "npm install && npm install --prefix demo",
    "demo": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build",
    "demo:install": "npm --prefix demo install",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "@yunary/ds": ">=0.1.5",
    "lucide-react": ">=0.400",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "tailwind-merge": "^3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "react-hook-form": "^7.87.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@yunary/ds": "github:Yamiro02/yunary-design-system#v0.1.5",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
